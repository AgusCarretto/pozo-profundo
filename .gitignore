# Godot 4+
.godot/
/android/

# Exports generados (se regeneran con tools/export_web.ps1)
build/

# Configuración de esta publicación (Supabase y link de Opinar). El ejemplo es data/online.example.json.
data/online.json

# Credenciales y firmas (Android / Play Store, fases F5+)
export_credentials.cfg
*.keystore
*.jks

# Temporales / editor
*.tmp
.vscode/
.idea/
.DS_Store
Thumbs.db

# Packs originales descargados (están en Drive; no se suben). El .gdignore sí se versiona: hace que Godot ignore la carpeta.
assets_src/*
!assets_src/.gdignore
assets_src.rar
